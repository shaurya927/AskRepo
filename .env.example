# ============================================================
# AskRepo — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit the .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/askrepo

# ── AI / LLM ────────────────────────────────────────────────
# Not used in Phase 1. Placeholder for Phase 3+.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── GitHub ───────────────────────────────────────────────────
# Optional. Provides higher rate limits for public repos.
GITHUB_TOKEN=

# ── Repository Limits ────────────────────────────────────────
MAX_REPOSITORY_SIZE_MB=50
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_MB=1

# ── Usage Limits ─────────────────────────────────────────────
MAX_AI_REQUESTS_PER_DAY=20
MAX_ANALYSES_PER_DAY=3

# ── Storage Paths ────────────────────────────────────────────
TEMP_REPOSITORY_PATH=./tmp/repos
VECTOR_INDEX_PATH=./tmp/indexes

# ── CORS ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── App ──────────────────────────────────────────────────────
DEBUG=true
