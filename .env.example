# ─── AskRepo Environment Configuration ───────────────────────
# Copy this file to backend/.env and fill in your values.

# ─── Core ─────────────────────────────────────────────────────
APP_NAME=AskRepo
DEBUG=false

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://askrepo:askrepo_dev@localhost:5432/askrepo

# ─── API Keys ─────────────────────────────────────────────────
# Google Gemini API key (required for AI chat)
GOOGLE_API_KEY=your-google-api-key-here

# GitHub personal access token (optional; increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# ─── AI Model ────────────────────────────────────────────────
AI_MODEL=gemini-2.5-flash
MAX_TOKENS_PER_REQUEST=4096

# ─── Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
VECTOR_SEARCH_TOP_K=15

# ─── Rate Limits ─────────────────────────────────────────────
MAX_ANALYSES_PER_DAY=3
MAX_AI_REQUESTS_PER_DAY=20

# ─── Repository Limits ──────────────────────────────────────
MAX_REPOSITORY_SIZE_MB=50
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_MB=1

# ─── Git Archaeology ────────────────────────────────────────
GIT_CLONE_DEPTH=200
GIT_MAX_DIFF_SIZE=50000

# ─── Paths ───────────────────────────────────────────────────
TEMP_REPOSITORY_PATH=./tmp/repos
VECTOR_INDEX_PATH=./tmp/indexes

# ─── CORS (comma-separated origins) ─────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Cleanup ─────────────────────────────────────────────────
CLEANUP_MAX_AGE_HOURS=1
